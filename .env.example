# ============================================================
#  Configuracao do Painel Movidesk - edite este arquivo
#  (o instalador cria uma copia como .env automaticamente)
# ============================================================

# Token PESSOAL do Movidesk (cada pessoa usa o seu).
# Gere em: Movidesk > Configuracoes > API > Tokens.
MOVIDESK_TOKEN=

# Atendente que o painel monitora (nome e e-mail).
MOVIDESK_AGENT_NAME=Seu Nome Completo
MOVIDESK_AGENT_EMAIL=seu.email@faturagil.com.br

# URL web do Movidesk (usada nos links dos tickets). Opcional.
MOVIDESK_WEB_URL=https://faturagil.movidesk.com

# Porta do painel local. Opcional.
MOVIDESK_PORT=8773

# Feriados extras da agenda (alem dos nacionais), no formato AAAA-MM-DD.
# Separe por virgula. Voce tambem pode usar o arquivo feriados.txt. Opcional.
# Ex.: MOVIDESK_FERIADOS=2026-12-08,2026-12-24

# ------------------------------------------------------------
# Times de atendimento (opcional - se deixar em branco, usa o padrao abaixo).
# Suporte: atendentes "de linha" (aparecem no Ranking por padrao).
# Dev: quem migrou para desenvolvimento (fica oculto no Ranking, aparece
#      com "mostrar time de dev"). Plantao: ordem do rodizio na tela Plantao.
# ------------------------------------------------------------
#MOVIDESK_AGENTES_SUPORTE=jefferson@faturagil.com.br,lucas@faturagil.com.br
#MOVIDESK_AGENTES_DEV=leandro@faturagil.com.br
#MOVIDESK_PLANTAO_ORDEM=lucas@faturagil.com.br,jefferson@faturagil.com.br
